#include <Arduino.h>
#include <Ds1302.h>

//Asignacion de pines
#define PIN_ENA 3
#define PIN_CLK 4
#define PIN_DAT 2
#define UltraSonido_TRIG 12
#define UltraSonido_ECHO 11

#define ValvulaLlenado 8
#define ValvulaVaciado 8

//Variables de codigo globales
bool llenadoHecho = false;
bool vaciadoHecho = false;

//Metodos del programa
float distanciaAgua() {
  digitalWrite(TRIG, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG, LOW);

  duracion = pulseIn(ECHO, HIGH);
  distancia = duracion * 0.034 / 2;
  return distancia;
}

float alturaActual() {
  return profundidadRecipiente - distanciaAgua();
}

void mostrarNivel() {
    Serial.print("Nivel actual: ");
    Serial.println(alturaActual());
}

bool esHoraDeRiego() {
  Ds1302::DateTime ahora;
  rtc.getDateTime(&ahora);
  int mesActual = ahora.month;
  int horaActual = ahora.hour;
  bool horaAdecuada = false;
  int horaVerano = 7;
  int horaInvierno = 14;

  if ((mesActual <= 4) || (mesActual >= 10)) { // Verano
    if (horaActual == horaVerano) horaAdecuada = true;
  } else { // Invierno
    if (horaActual == horaInvierno) horaAdecuada = true;
  }

  return horaAdecuada;
}

void activar(int numeroPin) {
  digitalWrite(numeroPin, LOW);
} 

void desactivar(int numeroPin) {
  digitalWrite(numeroPin, HIGH);
}


void realizarLlenado() {
  activar(valvulaLlenado);
  while (alturaActual() < nivelMaximo) {
    delay(1000);
    mostrarNivel();
  }
  desactivar(valvulaLlenado);
}

void realizarVaciado() {
  
}

void setup() {
  Serial.begin(9600);
  pinMode(TRIG, OUTPUT);
  pinMode(ECHO, INPUT);
  pinMode(ValvulaLlenado, OUTPUT);
  pinMode(ValvulaVaciado, OUTPUT);
}

void loop() {
  if (esHoraDeRiego()) {
    mostrarNivel();
    if (!llenadoHecho) {
    // --- CASO NORMAL: llenar si está bajo ---
      Serial.println("iniciando llenado.");
      if (alturaActual() < nivelMaximo)
        realizarLlenado();
      llenadoHecho = true;
      Serial.println("llenado realizado.");
    }
    Serial.println("Esperando remojo.");
    delay(tiempoRemojo);
    Serial.println("remojo realizado.");
    Serial.println("vaciado iniciando.");
    if (!vaciadoHecho) {
      realizarVaciado();
      vaciadoHecho = true;
    } 
    Serial.println("vaciado realizado.");
  } else {
    // Reinicio estado cuando termina la franja de riego
    if (llenadoHecho || vaciadoHecho) {
      llenadoHecho = false;
      vaciadoHecho = false;
      Serial.println("Fuera de hora de riego → reseteo estado");
    }
  }
  delay(intervaloDeLoop);
}
